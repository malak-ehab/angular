          <!-- ============================================= -->
          <div class="block">
            <h3>Decorators — Angular's metadata system</h3>

            <div class="note blue">
              <div class="note-label">📖 What are Decorators?</div>
              <p>A decorator is a special function that starts with <code>@</code> and attaches metadata (extra information) to classes, properties, or methods. Angular reads this metadata at startup to know how to handle each class.</p>

              <p><strong>Analogy - Price Tags in a Store:</strong> A product doesn't know its own price. The store attaches a price tag (decorator) that tells the cashier how to handle it. Similarly, Angular attaches decorators to tell Angular how to handle classes.</p>
            </div>

            <div class="note purple">
              <div class="note-label">📖 Common Angular Decorators</div>

              <pre data-lang="typescript"><span class="cm">// @Component - Marks a class as an Angular component (UI piece)</span>
      <span class="dec">@Component</span>({
        selector: 'app-user-card',
        template: '&lt;h1&gt;Hello World&lt;/h1&gt;'
      })
      export class UserCardComponent { }

      <span class="cm">// @Injectable - Marks a class as a service (can be injected into components)</span>
      <span class="dec">@Injectable</span>({ providedIn: 'root' })
      export class UserService { }

      <span class="cm">// @Input - Marks a property as receiving data from parent</span>
      export class ChildComponent {
        <span class="dec">@Input</span>() userName: string;
      }

      <span class="cm">// @Output - Marks an event that sends data to parent</span>
      export class ChildComponent {
        <span class="dec">@Output</span>() userSelected = new EventEmitter&lt;User&gt;();
      }

      <span class="cm">// @ViewChild - Gets a reference to a child component or DOM element</span>
      export class ParentComponent {
        <span class="dec">@ViewChild</span>(ChildComponent) child: ChildComponent;
      }

      <span class="cm">// @Pipe - Marks a class as a pipe (transforms data in templates)</span>
      <span class="dec">@Pipe</span>({ name: 'capitalize' })
      export class CapitalizePipe implements PipeTransform {
        transform(value: string): string {
          return value.toUpperCase();
        }
      }</pre>
            </div>

