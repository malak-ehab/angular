          <div class="block">
            <h3>Interfaces — defining data shapes</h3>

            <div class="note purple">
              <div class="note-label">📖 What is an Interface?</div>
              <p>An interface is like a contract or a blueprint. It describes WHAT properties an object must have, but doesn't provide the actual values.</p>

              <p><strong>Analogy - Job Application Form:</strong> The application form (interface) has fields for name, email, phone number. It doesn't contain the actual answers, but any application MUST provide those fields.</p>
            </div>

            <div class="note teal">
              <div class="note-label">📖 Defining and Using Interfaces</div>

              <pre data-lang="typescript"><span class="cm">// Define the interface (the contract)</span>
      interface User {
        id: number;           <span class="cm">// Required: must be a number</span>
        name: string;         <span class="cm">// Required: must be a string</span>
        email: string;        <span class="cm">// Required: must be a string</span>
        role: 'admin' | 'user';  <span class="cm">// Union type: only 'admin' or 'user'</span>
        createdAt?: Date;     <span class="cm">// Optional (? means may or may not exist)</span>
        phone?: string;       <span class="cm">// Optional property</span>
      }

      <span class="cm">// Create an object that follows the interface</span>
      const user1: User = {
        id: 1,
        name: "Sara",
        email: "sara@example.com",
        role: "admin",
        createdAt: new Date()  <span class="cm">// Optional, so ok to include</span>
      };

      const user2: User = {
        id: 2,
        name: "John",
        email: "john@example.com",
        role: "user"
        <span class="cm">// createdAt is optional, so ok to omit</span>
      };

      <span class="cm">// ❌ This would cause an error (missing required fields)</span>
      const user3: User = {
        id: 3,
        name: "Bob"
        <span class="cm">// Error: Property 'email' is missing</span>
        <span class="cm">// Error: Property 'role' is missing</span>
      };

      <span class="cm">// ❌ This would also error (wrong type for role)</span>
      const user4: User = {
        id: 4,
        name: "Alice",
        email: "alice@example.com",
        role: "superadmin"  <span class="cm">// Error: 'superadmin' is not assignable to type 'admin' | 'user'</span>
      };</pre>
            </div>

            <div class="note coral">
              <div class="note-label">📖 Functions with Interfaces</div>

              <pre data-lang="typescript"><span class="cm">// Function that expects a User object</span>
      function sendWelcomeEmail(user: User): string {
        return "Welcome dollar sign{user.name}! Check your email at dollar sign{user.email}"";
      }

      sendWelcomeEmail(user1);  <span class="cm">// ✅ Works!</span>

      <span class="cm">// Function that returns a User object</span>
      function createDefaultUser(id: number, name: string): User {
