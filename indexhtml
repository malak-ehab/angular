      <span class="cm">&lt;!-- Date pipe - format dates --&gt;</span>
      &lt;p&gt;Date: {{ date | date:'fullDate' }}&lt;/p&gt;
      <span class="cm">// Output: Monday, January 15, 2024</span>
      &lt;p&gt;Date: {{ date | date:'dd/MM/yyyy' }}&lt;/p&gt;
      <span class="cm">// Output: 15/01/2024</span>
      &lt;p&gt;Date: {{ date | date:'shortTime' }}&lt;/p&gt;
