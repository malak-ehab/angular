            { path: <span class="str">'section/:sectionId'</span>, component: DocViewerComponent },
            { path: <span class="str">''</span>, redirectTo: <span class="str">'favorites'</span>, pathMatch: <span class="str">'full'</span> }
          ]
        },
        { path: <span class="str">''</span>, redirectTo: <span class="str">'/docs'</span>, pathMatch: <span class="str">'full'</span> },
        { path: <span class="str">'**'</span>, redirectTo: <span class="str">'/docs'</span> }  <span class="cm">// Wildcard - any unknown URL goes to docs</span>
      ];</pre>

