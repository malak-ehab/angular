          <div class="block">
            <h3>Complete Routing Example: E-commerce App</h3>

            <div class="note green">
              <div class="note-label">📖 Putting It All Together</div>

              <pre data-lang="typescript"><span class="cm">// app.routes.ts - Complete e-commerce routing</span>
      <span class="kw">export const</span> routes: Routes = [
