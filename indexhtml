      let hasPermission: boolean = false;

      <span class="cm">// 4. array - collections of items</span>
      let numbers: number[] = [1, 2, 3, 4, 5];
      let names: string[] = ["Alice", "Bob", "Charlie"];
      let users: User[] = [user1, user2, user3];  <span class="cm">// Array of User objects</span>

