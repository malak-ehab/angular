        }

        ngOnDestroy() {
          <span class="cm">// This triggers takeUntil to unsubscribe EVERYTHING</span>
          this.destroy$.next();
          this.destroy$.complete();
        }
      }</pre>

              <p><strong>Why this is so important:</strong></p>
              <ul>
                <li>Without takeUntil, subscriptions survive after component is destroyed</li>
                <li>Each navigation creates MORE subscriptions that never die</li>
                <li>After 100 navigations, 100 subscriptions running in background</li>
                <li>App becomes slower, uses more memory, eventually crashes</li>
              </ul>
              <p><strong>This is the standard pattern for ALL Angular components!</strong></p>
            </div>
          </div>

          <!-- ============================================= -->
          <!-- BLOCK 4: $ Naming Convention                  -->
          <!-- ============================================= -->
          <div class="block">
            <h3>The $ naming convention</h3>
            <p>By Angular convention, variable names ending in <code>$</code> are Observables. This tells other developers at a glance: "this is a stream, not a plain value — remember to subscribe."</p>

            <div class="note teal">
              <div class="note-label">📖 Why the $ Suffix?</div>

              <pre data-lang="typescript"><span class="cm">// Clear distinction between plain values and streams</span>
      <span class="kw">export class</span> UserComponent {
        <span class="cm">// Plain values (synchronous, single value)</span>
        userName: <span class="tp">string</span> = <span class="str">'John'</span>;
        userAge: <span class="tp">number</span> = <span class="num">25</span>;
        isLoggedIn: <span class="tp">boolean</span> = <span class="kw">false</span>;

        <span class="cm">// Observables (asynchronous, stream of values over time)</span>
        users$: <span class="tp">Observable</span>&lt;<span class="tp">User</span>[]&gt;;
        currentUser$: <span class="tp">Observable</span>&lt;<span class="tp">User</span> | <span class="kw">null</span>&gt;;
        isLoading$: <span class="tp">Observable</span>&lt;<span class="tp">boolean</span>&gt;;
        destroy$: <span class="tp">Subject</span>&lt;<span class="tp">void</span>&gt;;
      }</pre>

              <p><strong>Benefits:</strong></p>
              <ul>
                <li><strong>Readability:</strong> Instantly know which variables need subscription</li>
                <li><strong>Prevents mistakes:</strong> You won't forget to subscribe because $ reminds you</li>
                <li><strong>Template clarity:</strong> <code>{{ users$ | async }}</code> clearly shows async pipe usage</li>
                <li><strong>Industry standard:</strong> All Angular developers understand this convention</li>
              </ul>

              <p><strong>Template usage with $:</strong></p>
              <pre data-lang="html"><span class="cm">&lt;!-- Plain value - just display --&gt;</span>
      &lt;p&gt;{{ userName }}&lt;/p&gt;

      <span class="cm">&lt;!-- Observable - MUST use async pipe or subscribe --&gt;</span>
      &lt;ul&gt;
        &lt;li *ngFor="let user of users$ | async"&gt;{{ user.name }}&lt;/li&gt;
      &lt;/ul&gt;

      <span class="cm">&lt;!-- Loading state - async pipe with else --&gt;</span>
      &lt;div *ngIf="isLoading$ | async; else loaded"&gt;
        Loading...
      &lt;/div&gt;
      &lt;ng-template #loaded&gt;
        Data is ready!
      &lt;/ng-template&gt;</pre>
            </div>
          </div>

          <!-- ============================================= -->
          <!-- BLOCK 5: shareReplay - Caching               -->
          <!-- ============================================= -->
          <div class="block">
            <h3>shareReplay — cache HTTP responses</h3>
            <p>By default, every subscriber triggers a new HTTP call. <code>shareReplay(1)</code> caches the latest result and replays it to all subscribers — so 5 components can subscribe to the same Observable with only 1 HTTP request.</p>

            <div class="note coral">
              <div class="note-label">📖 Detailed Explanation: shareReplay</div>

              <p><strong>The Problem - Multiple Subscribers = Multiple HTTP Calls:</strong></p>
              <pre data-lang="typescript"><span class="kw">export class</span> BadService {
        getUsers() {
          <span class="kw">return</span> this.http.get(<span class="str">'/api/users'</span>);  <span class="cm">// No caching</span>
        }
      }

      <span class="cm">// In different components (same page!)</span>
      this.badService.getUsers().subscribe(users => this.users1 = users);  <span class="cm">// HTTP call 1</span>
      this.badService.getUsers().subscribe(users => this.users2 = users);  <span class="cm">// HTTP call 2</span>
      this.badService.getUsers().subscribe(users => this.users3 = users);  <span class="cm">// HTTP call 3</span>
      <span class="cm">// 3 components = 3 separate HTTP requests to the same endpoint! WASTEFUL!</span></pre>

              <p><strong>The Solution - shareReplay(1):</strong></p>
              <pre data-lang="typescript"><span class="kw">import</span> { shareReplay } <span class="kw">from</span> <span class="str">'rxjs/operators</span>';

      <span class="kw">export class</span> GoodService {
        <span class="kw">private</span> users$: Observable&lt;User[]&gt;;

        getUsers() {
          <span class="kw">if</span> (!this.users$) {
            this.users$ = this.http.get&lt;User[]&gt;(<span class="str">'/api/users'</span>).pipe(
              shareReplay(<span class="num">1</span>)  <span class="cm">// Cache the result</span>
            );
          }
          <span class="kw">return</span> this.users$;
        }
      }

      <span class="cm">// In components (same page!)</span>
      this.goodService.getUsers().subscribe(users => this.users1 = users);  <span class="cm">// HTTP call 1 (only one!)</span>
      this.goodService.getUsers().subscribe(users => this.users2 = users);  <span class="cm">// Gets cached result</span>
      this.goodService.getUsers().subscribe(users => this.users3 = users);  <span class="cm">// Gets cached result</span>
      <span class="cm">// 3 components = 1 HTTP request! MUCH BETTER!</span></pre>

              <p><strong>How shareReplay works:</strong></p>
              <ul>
                <li>First subscriber triggers the HTTP request</li>
                <li>The response is stored (cached)</li>
                <li>All subsequent subscribers get the cached response immediately</li>
                <li>The HTTP request never happens again (for the life of the service)</li>
              </ul>

              <div class="note amber">
                <div class="note-label">⚠️ When to use shareReplay:</div>
                <ul>
                  <li><strong>✅ GOOD:</strong> Configuration data that never changes (app settings, feature flags)</li>
                  <li><strong>✅ GOOD:</strong> Static data that changes rarely (list of countries, categories)</li>
                  <li><strong>❌ BAD:</strong> Real-time data that changes frequently (stock prices, notifications)</li>
                  <li><strong>❌ BAD:</strong> User-specific data that can change (user profile after edit)</li>
                </ul>
                <p>For data that can change, you need a way to refresh the cache (clear and reload).</p>
              </div>
            </div>
          </div>

