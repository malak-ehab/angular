            <div class="note coral">
              <div class="note-label">📖 3 Rules of computed()</div>

              <p><strong>1. Read-only</strong> — Cannot call <code>.set()</code> or <code>.update()</code> on a computed signal</p>
              <pre data-lang="typescript"><span class="cm">// ❌ ERROR - Cannot modify computed signal</span>
      this.total.set(<span class="num">500</span>);  <span class="cm">// TypeScript error!</span>
      this.total.update(t => t + <span class="num">100</span>);  <span class="cm">// TypeScript error!</span>

      <span class="cm">// ✅ CORRECT - Modify the source signals instead</span>
      this.price.set(<span class="num">150</span>);  <span class="cm">// This updates computed signals automatically</span></pre>

              <p><strong>2. Memoized</strong> — Returns cached value if no dependency changed</p>
              <pre data-lang="typescript"><span class="kw">const</span> expensive = computed(() => {
        <span class="cm">// This function ONLY runs when dependencies change</span>
        <span class="cm">// If you read expensive() 100 times without changes, runs ONCE!</span>
        <span class="kw">return</span> doExpensiveCalculation(this.data());
      });</pre>

              <p><strong>3. Lazy</strong> — Only evaluates when something reads it</p>
              <pre data-lang="typescript"><span class="kw">const</span> lazy = computed(() => {
        console.log(<span class="str">'This runs when someone reads lazy()'</span>);
        <span class="kw">return</span> this.someSignal() * <span class="num">2</span>;
      });

      <span class="cm">// Nothing logged yet! Computed hasn't been read.</span>

      <span class="kw">const</span> result = lazy();  <span class="cm">// NOW it runs and logs</span>
      <span class="cm">// Second read: uses cached value (no log unless dependencies changed)</span></pre>
