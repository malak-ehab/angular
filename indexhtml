              <pre data-lang="typescript"><span class="cm">// Generate pipe: ng g pipe shared/pipes/truncate</span>

      <span class="kw">import</span> { Pipe, PipeTransform } <span class="kw">from</span> <span class="str">'@angular/core'</span>;

      <span class="dec">@Pipe</span>({
        name: <span class="str">'truncate'</span>,
        standalone: <span class="kw">true</span>
      })
      <span class="kw">export class</span> TruncatePipe <span class="kw">implements</span> PipeTransform {

        transform(value: <span class="tp">string</span>, limit: <span class="tp">number</span> = <span class="num">50</span>, suffix: <span class="tp">string</span> = <span class="str">'...'</span>): <span class="tp">string</span> {
          <span class="kw">if</span> (!value) <span class="kw">return</span> <span class="str">''</span>;
          <span class="kw">if</span> (value.length <= limit) <span class="kw">return</span> value;
          <span class="kw">return</span> value.substring(<span class="num">0</span>, limit) + suffix;
        }
      }

      <span class="cm">// Usage in template</span>
      &lt;p&gt;{{ longText | truncate:30:'... read more' }}&lt;/p&gt;
      <span class="cm">// If longText is 100 chars, shows first 30 chars + "... read more"</span></pre>
