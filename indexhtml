          <!-- ============================================= -->
          <div class="block">
            <h3>The Singleton Pattern</h3>

            <div class="note coral">
              <div class="note-label">📖 What is a Singleton?</div>

              <pre data-lang="typescript"><span class="dec">@Injectable</span>({
        providedIn: <span class="str">'root'</span>    <span class="cm">// ← This creates a singleton!</span>
      })</pre>

              <p><strong>Singleton = ONE instance shared across the entire application.</strong></p>

              <div class="compare">
                <div class="compare-cell">
                  <div class="label">❌ Without Singleton (new keyword)</div>
                  <pre data-lang="typescript"><span class="kw">const</span> service1 = <span class="kw">new</span> UserService();
      <span class="kw">const</span> service2 = <span class="kw">new</span> UserService();
      <span class="cm">// Two DIFFERENT instances! service1 !== service2</span>
      <span class="cm">// Changes in service1 don't affect service2</span></pre>
                </div>
                <div class="compare-cell">
                  <div class="label">✅ With Singleton (Angular DI)</div>
                  <pre data-lang="typescript"><span class="kw">constructor</span>(<span class="kw">private</span> service: UserService) {}
      <span class="cm">// All components get the SAME instance!</span>
      <span class="cm">// Any component's changes are visible to ALL components</span></pre>
                </div>
