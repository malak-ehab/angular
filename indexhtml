              </table>
            </div>
          </div>

          <!-- ============================================= -->
          <!-- BLOCK 2: Defining Routes                      -->
          <!-- ============================================= -->
          <div class="block">
            <h3>Defining routes</h3>

            <div class="note purple">
              <div class="note-label">📖 Basic Route Configuration</div>

              <pre data-lang="typescript"><span class="cm">// app.routes.ts - This file tells Angular what component to show for each URL</span>
      <span class="kw">import</span> { Routes } <span class="kw">from</span> <span class="str">'@angular/router'</span>;
      <span class="kw">import</span> { HomeComponent } <span class="kw">from</span> <span class="str">'./home/home.component'</span>;
      <span class="kw">import</span> { AboutComponent } <span class="kw">from</span> <span class="str">'./about/about.component'</span>;
      <span class="kw">import</span> { UsersComponent } <span class="kw">from</span> <span class="str">'./users/users.component'</span>;
      <span class="kw">import</span> { UserDetailComponent } <span class="kw">from</span> <span class="str">'./users/user-detail.component'</span>;
      <span class="kw">import</span> { NotFoundComponent } <span class="kw">from</span> <span class="str">'./not-found/not-found.component'</span>;

      <span class="kw">export const</span> routes: <span class="tp">Routes</span> = [
        // Route 1: Home page (empty path = default route)
        { path: <span class="str">''</span>, component: HomeComponent },

        // Route 2: About page
        { path: <span class="str">'about'</span>, component: AboutComponent },

        // Route 3: Users list page
        { path: <span class="str">'users'</span>, component: UsersComponent },

        // Route 4: Dynamic user detail page (:id is a placeholder for any value)
        { path: <span class="str">'users/:id'</span>, component: UserDetailComponent },
        // Examples: /users/1, /users/42, /users/john-doe

        // Route 5: 404 - Wildcard route (MUST be last!)
        { path: <span class="str">'**'</span>, component: NotFoundComponent }
        // The ** matches ANY URL that didn't match previous routes
      ];</pre>

              <div class="note teal">
                <div class="note-label">📖 Understanding Route Paths</div>

                <p><strong>Path Types Explained:</strong></p>
                <ul>
                  <li><strong>'' (empty string)</strong> - The default/home page. When URL is just "myapp.com/"</li>
                  <li><strong>'about'</strong> - Static route. Exactly matches "myapp.com/about"</li>
                  <li><strong>'users/:id'</strong> - Dynamic route with parameter. :id can be any value</li>
                  <li><strong>'**'</strong> - Wildcard route. Matches ANY URL not caught above. Perfect for 404 pages</li>
                </ul>

                <p><strong>Route Priority:</strong> Routes are checked in ORDER they are defined. First match wins!</p>
                <pre data-lang="text">URL: /users/42
      1. Check ''? No
      2. Check 'about'? No
      3. Check 'users'? No (users/42 is different from users)
      4. Check 'users/:id'? YES! ✅ Shows UserDetailComponent

      URL: /does-not-exist
      1. Check ''? No
      2. Check 'about'? No
      3. Check 'users'? No
      4. Check 'users/:id'? No
      5. Check '**'? YES! ✅ Shows NotFoundComponent</pre>
              </div>
            </div>

            <div class="note coral">
              <div class="note-label">📖 Nested Routes (Child Routes)</div>

              <p><strong>Why nested routes?</strong> Sometimes you want a layout that stays the same, with only a portion changing.</p>

              <pre data-lang="typescript"><span class="cm">// Example: Documentation section with persistent sidebar</span>
      {
        path: <span class="str">'docs'</span>,
        component: ShellComponent,  <span class="cm">// This component has the sidebar and &lt;router-outlet&gt;</span>
        children: [
          // These components render INSIDE ShellComponent's &lt;router-outlet&gt;
          { path: <span class="str">'getting-started'</span>, component: GettingStartedComponent },
          { path: <span class="str">'api-reference'</span>, component: ApiReferenceComponent },
          { path: <span class="str">'tutorials/:id'</span>, component: TutorialComponent },
          { path: <span class="str">''</span>, redirectTo: <span class="str">'getting-started'</span>, pathMatch: <span class="str">'full'</span> }
        ]
      }</pre>

              <div class="note amber">
                <div class="note-label">🎯 URL Structure with Nested Routes</div>
                <ul>
                  <li><strong>/docs</strong> → Shows ShellComponent (sidebar + header) + redirects to getting-started in the center</li>
                  <li><strong>/docs/getting-started</strong> → ShellComponent stays, GettingStartedComponent in center</li>
                  <li><strong>/docs/api-reference</strong> → ShellComponent stays, ApiReferenceComponent in center</li>
                  <li><strong>/docs/tutorials/angular-basics</strong> → ShellComponent stays, TutorialComponent with param in center</li>
                </ul>
                <p><strong>Result:</strong> Sidebar NEVER re-renders! Only the center content changes. Much faster user experience!</p>
              </div>
            </div>
          </div>

          <!-- ============================================= -->
          <!-- BLOCK 3: Template Navigation                  -->
          <!-- ============================================= -->
          <div class="block">
            <h3>Template navigation</h3>

            <div class="note teal">
              <div class="note-label">📖 routerLink vs href - CRITICAL Difference</div>

              <pre data-lang="html"><span class="cm">&lt;!-- ❌ WRONG - Causes full page reload! --&gt;</span>
      &lt;a href="/about"&gt;About&lt;/a&gt;
      &lt;!--
        When clicked:
        1. Browser sends request to server
        2. Server sends entire new HTML page
        3. Angular app restarts from scratch!
        4. All state lost! ❌
      --&gt;

      <span class="cm">&lt;!-- ✅ CORRECT - SPA navigation --&gt;</span>
      &lt;a routerLink="/about"&gt;About&lt;/a&gt;
      &lt;!--
        When clicked:
        1. Angular Router intercepts click
        2. URL updates (using browser History API)
        3. Router finds matching component
        4. Swaps component in &lt;router-outlet&gt;
        5. NO page reload! State preserved! ✅
      --&gt;</pre>

              <div class="note red">
                <div class="note-label">🚨 IMPORTANT</div>
                <p><strong>NEVER use href for internal links in Angular!</strong> href causes a full page reload, destroying your app's state and defeating the purpose of an SPA. Always use routerLink!</p>
              </div>
            </div>

            <div class="note purple">
              <div class="note-label">📖 routerLink Examples</div>

              <pre data-lang="html"><span class="cm">&lt;!-- Static link - simple string --&gt;</span>
      &lt;a routerLink="/about"&gt;About&lt;/a&gt;

      <span class="cm">&lt;!-- Dynamic link with parameter - array syntax --&gt;</span>
      &lt;a [routerLink]="['/users', userId]"&gt;View Profile&lt;/a&gt;
      <span class="cm">// If userId = 42, goes to /users/42</span>

      <span class="cm">&lt;!-- Multiple parameters --&gt;</span>
      &lt;a [routerLink]="['/products', categoryId, productId]"&gt;View Product&lt;/a&gt;
      <span class="cm">// If categoryId=5, productId=123 → /products/5/123</span>

      <span class="cm">&lt;!-- With query parameters (like ?search=angular&page=2) --&gt;</span>
      &lt;a [routerLink]="['/search']" [queryParams]="{search: 'angular', page: 2}"&gt;Search&lt;/a&gt;
      <span class="cm">// Goes to: /search?search=angular&page=2</span>

      <span class="cm">&lt;!-- Relative navigation (from current route) --&gt;</span>
      &lt;a routerLink="../"&gt;Go Back&lt;/a&gt;  <span class="cm">// One level up</span>
      &lt;a routerLink="./edit"&gt;Edit&lt;/a&gt;   <span class="cm">// Stay in same directory, go to edit</span></pre>
            </div>

            <div class="note green">
              <div class="note-label">📖 Highlighting Active Links (routerLinkActive)</div>

              <pre data-lang="html"><span class="cm">&lt;!-- Add CSS class 'active' when this link matches current URL --&gt;</span>
      &lt;a routerLink="/" routerLinkActive="active"&gt;Home&lt;/a&gt;

      <span class="cm">&lt;!-- Exact match - only highlight when URL is EXACTLY /, not /about --&gt;</span>
      &lt;a routerLink="/" routerLinkActive="active" [routerLinkActiveOptions]="{exact: true}"&gt;Home&lt;/a&gt;

      <span class="cm">&lt;!-- Multiple classes or custom styling --&gt;</span>
      &lt;a routerLink="/users" routerLinkActive="active-link highlighted"&gt;Users&lt;/a&gt;

      <span class="cm">&lt;!-- Using with ngClass or style binding --&gt;</span>
      &lt;a routerLink="/profile"
         routerLinkActive="active"
         #rla="routerLinkActive"
         [style.color]="rla.isActive ? 'blue' : 'gray'"&gt;
        Profile ({{ rla.isActive ? 'active' : 'inactive' }})
      &lt;/a&gt;</pre>

              <div class="note amber">
                <div class="note-label">🎯 routerLinkActiveOptions Explained</div>
                <ul>
                  <li><strong>{ exact: true }</strong> - Only highlight if URL matches EXACTLY</li>
                  <li><strong>{ exact: false }</strong> - Highlight if URL STARTS WITH this path (default)</li>
                </ul>
                <pre data-lang="text">URL: /users/42/profile
      - /users (exact: false) → HIGHLIGHTS ✅ (starts with /users)
      - /users (exact: true)  → NO HIGHLIGHT ❌ (not exact match)</pre>
              </div>
            </div>

            <div class="note blue">
              <div class="note-label">📖 The Router Outlet</div>

              <pre data-lang="html"><span class="cm">&lt;!-- In your main app component --&gt;</span>
      &lt;div class="app-container"&gt;
        &lt;app-header&gt;&lt;/app-header&gt;

        &lt;main&gt;
          <span class="cm">&lt;!-- This is where routed components appear! --&gt;</span>
          &lt;router-outlet&gt;&lt;/router-outlet&gt;
        &lt;/main&gt;

        &lt;app-footer&gt;&lt;/app-footer&gt;
      &lt;/div&gt;</pre>

              <p><strong>How it works:</strong></p>
              <ol>
                <li>You put <code>&lt;router-outlet&gt;</code> where you want routed content to appear</li>
                <li>When user navigates to "/home", Angular removes whatever is in the outlet</li>
                <li>Angular creates HomeComponent and puts it in the outlet</li>
                <li>When user navigates to "/about", HomeComponent is destroyed, AboutComponent is created</li>
                <li>Header and footer stay in place (they're outside the outlet)</li>
              </ol>

              <div class="note coral">
                <div class="note-label">📌 Multiple Router Outlets (Advanced)</div>
                <pre data-lang="html"><span class="cm">&lt;!-- Primary outlet (default) --&gt;</span>
      &lt;router-outlet&gt;&lt;/router-outlet&gt;

      <span class="cm">&lt;!-- Named outlet for side content --&gt;</span>
      &lt;router-outlet name="sidebar"&gt;&lt;/router-outlet&gt;

      <span class="cm">&lt;!-- Route configuration for named outlets --&gt;</span>
      {
        path: <span class="str">'dashboard'</span>,
        component: DashboardComponent,
        children: [
          { path: <span class="str">'stats'</span>, component: StatsComponent, outlet: <span class="str">'sidebar'</span> }
        ]
      }</pre>
              </div>
            </div>
          </div>

          <!-- ============================================= -->
          <!-- BLOCK 4: Reading URL Parameters               -->
          <!-- ============================================= -->
          <div class="block">
            <h3>Reading URL parameters</h3>

            <div class="note purple">
              <div class="note-label">📖 Accessing Route Parameters in Components</div>

              <pre data-lang="typescript"><span class="kw">import</span> { Component, OnInit, OnDestroy } <span class="kw">from</span> <span class="str">'@angular/core'</span>;
      <span class="kw">import</span> { ActivatedRoute } <span class="kw">from</span> <span class="str">'@angular/router'</span>;
      <span class="kw">import</span> { Subject, switchMap, takeUntil } <span class="kw">from</span> <span class="str">'rxjs'</span>;

      <span class="kw">export class</span> UserDetailComponent <span class="kw">implements</span> OnInit, OnDestroy {
        userId!: <span class="tp">string</span>;
        userData: User | <span class="kw">null</span> = <span class="kw">null</span>;
        <span class="kw">private</span> destroy$ = <span class="kw">new</span> Subject&lt;<span class="tp">void</span>&gt;();

        <span class="kw">constructor</span>(
          <span class="kw">private</span> route: ActivatedRoute,      <span class="cm">// Gives access to current route info</span>
          <span class="kw">private</span> userService: UserService
        ) {}

        ngOnInit() {
          <span class="cm">// METHOD 1: Snapshot (good for one-time read, when param doesn't change within component)</span>
          this.userId = this.route.snapshot.paramMap.get(<span class="str">'id'</span>)!;
          <span class="cm">// If URL is /users/42, userId becomes '42'</span>
          <span class="cm">// ⚠️ WARNING: This ONLY reads the value ONCE when component loads</span>
          <span class="cm">// If param changes while component is alive (e.g., /users/42 → /users/43), this won't update!</span>

          <span class="cm">// METHOD 2: Observable (recommended - reacts to parameter changes)</span>
          this.route.paramMap.pipe(
            takeUntil(this.destroy$)
          ).subscribe(params => {
            this.userId = params.get(<span class="str">'id'</span>)!;
            console.log(<span class="str">'User ID changed to:'</span>, this.userId);
            this.loadUserData();  <span class="cm">// Reload data when param changes</span>
          });

          <span class="cm">// METHOD 3: Using switchMap for automatic data loading (MOST ELEGANT)</span>
          this.route.paramMap.pipe(
            switchMap(params => {
              const id = params.get(<span class="str">'id'</span>)!;
              <span class="kw">return</span> this.userService.getUserById(id);
            }),
            takeUntil(this.destroy$)
          ).subscribe(user => {
            this.userData = user;
          });
        }

        loadUserData() {
          this.userService.getUserById(this.userId).subscribe(user => {
            this.userData = user;
          });
        }

        ngOnDestroy() {
          this.destroy$.next();
          this.destroy$.complete();
        }
      }</pre>

              <div class="note amber">
                <div class="note-label">📖 Different Types of Route Parameters</div>

                <p><strong>1. Path Parameters (/users/:id)</strong></p>
                <pre data-lang="typescript"><span class="cm">// URL: /users/42</span>
      this.route.snapshot.paramMap.get(<span class="str">'id'</span>);  <span class="cm">// Returns '42'</span>

      <p><strong>2. Query Parameters (?search=angular&page=2)</strong></p>
      <pre data-lang="typescript"><span class="cm">// URL: /search?search=angular&page=2</span>
      this.route.snapshot.queryParamMap.get(<span class="str">'search'</span>);  <span class="cm">// Returns 'angular'</span>
      this.route.snapshot.queryParamMap.get(<span class="str">'page'</span>);     <span class="cm">// Returns '2'</span>

      <span class="cm">// Observable version</span>
      this.route.queryParamMap.subscribe(params => {
        const search = params.get(<span class="str">'search'</span>);
        const page = params.get(<span class="str">'page'</span>);
      });

      <p><strong>3. Fragment (#section)</strong></p>
      <pre data-lang="typescript"><span class="cm">// URL: /docs#installation</span>
      this.route.snapshot.fragment;  <span class="cm">// Returns 'installation'</span></pre>

              <div class="note green">
                <div class="note-label">🎯 When to use Snapshot vs Observable</div>
                <ul>
                  <li><strong>Use Snapshot when:</strong>
                    <ul>
                      <li>Component creates, reads parameter ONCE, never needs to react to changes</li>
                      <li>Example: Blog post page (user doesn't change post ID while on page)</li>
                    </ul>
                  </li>
                  <li><strong>Use Observable when:</strong>
                    <ul>
                      <li>Parameter can change while component is alive</li>
                      <li>Example: Product gallery with next/prev buttons that change URL</li>
                      <li>Example: Component with "Next User" button that updates user ID in URL</li>
                    </ul>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- ============================================= -->
          <!-- BLOCK 5: Programmatic Navigation              -->
          <!-- ============================================= -->
          <div class="block">
            <h3>Programmatic navigation</h3>

            <div class="note teal">
              <div class="note-label">📖 Navigating from TypeScript Code</div>

              <pre data-lang="typescript"><span class="kw">import</span> { Component, inject } <span class="kw">from</span> <span class="str">'@angular/core'</span>;
      <span class="kw">import</span> { Router } <span class="kw">from</span> <span class="str">'@angular/router'</span>;

      <span class="kw">export class</span> AuthComponent {
        <span class="kw">private</span> router = inject(Router);

        login() {
          <span class="cm">// After successful login, redirect to dashboard</span>
          this.authService.login(credentials).subscribe(() => {
            this.router.navigate([<span class="str">'/dashboard'</span>]);  <span class="cm">// Simple navigation</span>
          });
        }

        viewUser(userId: <span class="tp">number</span>) {
          <span class="cm">// Navigate with parameters</span>
          this.router.navigate([<span class="str">'/users'</span>, userId]);
          <span class="cm">// Results in: /users/42</span>
        }

        searchProducts() {
          <span class="cm">// Navigate with query parameters</span>
          this.router.navigate([<span class="str">'/search'</span>], {
            queryParams: { q: <span class="str">'angular'</span>, category: <span class="str">'books'</span>, page: <span class="num">1</span> }
          });
          <span class="cm">// Results in: /search?q=angular&category=books&page=1</span>
        }

        goToSection() {
          <span class="cm">// Navigate with fragment (scroll to section)</span>
          this.router.navigate([<span class="str">'/docs'</span>], { fragment: <span class="str">'installation'</span> });
          <span class="cm">// Results in: /docs#installation</span>
        }

        navigateWithReplace() {
          <span class="cm">// Replace current URL in history (no back button to previous page)</span>
          this.router.navigate([<span class="str">'/home'</span>], { replaceUrl: <span class="kw">true</span> });
        }

        fullUrlNavigation() {
          <span class="cm">// Navigate using full URL string</span>
          this.router.navigateByUrl(<span class="str">'/products/123?tab=reviews#top'</span>);
        }

        relativeNavigation() {
          <span class="cm">// Navigate relative to current route</span>
          this.router.navigate([<span class="str">'edit'</span>], { relativeTo: this.route });
          <span class="cm">// If currently at /users/42, goes to /users/42/edit</span>
        }
      }</pre>

              <div class="note amber">
                <div class="note-label">📖 Navigation Options</div>
                <table class="data-table">
                  <thead><tr><th>Option</th><th>Description</th><th>Use case</th></tr></thead>
                  <tbody>
                    <tr><td>queryParams</td><td>Add query parameters to URL</td><td>Search filters, pagination</td></tr>
                    <tr><td>fragment</td><td>Add #fragment to URL</td><td>Scroll to section, anchor links</td></tr>
                    <tr><td>replaceUrl</td><td>Replace current history entry</td><td>Redirects, login pages (can't go back)</td></tr>
                    <tr><td>relativeTo</td><td>Navigate relative to current route</td><td>Edit forms, child routes</td></tr>
                    <tr><td>skipLocationChange</td><td>Navigate without changing URL</td><td>Modal popups, temporary views</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- ============================================= -->
          <!-- BLOCK 6: Route Guards (Protection)            -->
          <!-- ============================================= -->
          <div class="block">
            <h3>Route Guards — Protecting Routes</h3>

            <div class="note coral">
              <div class="note-label">📖 Preventing Unauthorized Access</div>

              <pre data-lang="typescript"><span class="cm">// auth.guard.ts - Prevents unauthenticated users from accessing routes</span>
      <span class="kw">import</span> { inject } <span class="kw">from</span> <span class="str">'@angular/core'</span>;
      <span class="kw">import</span> { Router } <span class="kw">from</span> <span class="str">'@angular/router'</span>;
      <span class="kw">import</span> { AuthService } <span class="kw">from</span> <span class="str">'./auth.service'</span>;

      <span class="kw">export const</span> authGuard = (): <span class="tp">boolean</span> => {
        const authService = inject(AuthService);
        const router = inject(Router);

        <span class="kw">if</span> (authService.isLoggedIn()) {
          <span class="kw">return true</span>;  <span class="cm">// Allow access</span>
        }

        <span class="cm">// Not logged in - redirect to login page</span>
        router.navigate([<span class="str">'/login'</span>], {
          queryParams: { returnUrl: router.url }  <span class="cm">// Save where they tried to go</span>
        });
        <span class="kw">return false</span>;  <span class="cm">// Block access</span>
      };

      <span class="cm">// admin.guard.ts - Restricts to admin users only</span>
      <span class="kw">export const</span> adminGuard = (): <span class="tp">boolean</span> => {
        const authService = inject(AuthService);
        const router = inject(Router);

        <span class="kw">if</span> (authService.isAdmin()) {
          <span class="kw">return true</span>;
        }

        router.navigate([<span class="str">'/forbidden'</span>]);
        <span class="kw">return false</span>;
      };

      <span class="cm">// Using guards in routes</span>
      <span class="kw">export const</span> routes: Routes = [
        { path: <span class="str">'dashboard'</span>, component: DashboardComponent, canActivate: [authGuard] },
        { path: <span class="str">'admin'</span>, component: AdminComponent, canActivate: [adminGuard] },
        { path: <span class="str">'profile'</span>, component: ProfileComponent, canActivate: [authGuard] },
        { path: <span class="str">'login'</span>, component: LoginComponent },  <span class="cm">// No guard - public</span>
      ];</pre>

              <div class="note teal">
                <div class="note-label">📖 Other Types of Guards</div>
                <ul>
                  <li><strong>canActivate</strong> - Can the user ENTER this route?</li>
                  <li><strong>canActivateChild</strong> - Can the user enter CHILD routes?</li>
                  <li><strong>canDeactivate</strong> - Can the user LEAVE this route? (Unsaved changes warning)</li>
                  <li><strong>canLoad</strong> - Can the user LAZY LOAD this module?</li>
                  <li><strong>resolve</strong> - Pre-fetch data before showing route</li>
                </ul>

                <pre data-lang="typescript"><span class="cm">// canDeactivate example - warn about unsaved changes</span>
      <span class="kw">export const</span> unsavedChangesGuard = (component: FormComponent): <span class="tp">boolean</span> => {
        <span class="kw">if</span> (component.form.dirty) {
          <span class="kw">return</span> confirm(<span class="str">'You have unsaved changes. Do you really want to leave?'</span>);
        }
        <span class="kw">return true</span>;
      };

      <span class="cm">// Resolver - load data before showing component</span>
      <span class="kw">export const</span> userResolver = (): <span class="tp">Observable</span>&lt;User&gt; => {
        const userService = inject(UserService);
        <span class="kw">return</span> userService.getCurrentUser();
      };

      <span class="kw">export const</span> routes: Routes = [
        {
          path: <span class="str">'profile'</span>,
          component: ProfileComponent,
          canActivate: [authGuard],
          canDeactivate: [unsavedChangesGuard],
          resolve: { user: userResolver }  <span class="cm">// Data available before component loads</span>
        }
      ];</pre>
              </div>
            </div>
          </div>

