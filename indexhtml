          </div>

          <!-- ============================================= -->
          <!-- BLOCK 4: effect() - Side Effects             -->
          <!-- ============================================= -->
          <div class="block">
            <h3>effect() — reactive side effects</h3>
            <p>Runs when the component initializes, then re-runs every time a signal it reads changes. Unlike <code>computed()</code>, it returns nothing — it's for external side effects only.</p>

            <div class="note purple">
              <div class="note-label">📖 What is an Effect?</div>

              <p><strong>When to use effect():</strong> When you need to DO something (not calculate something) when signals change.</p>
              <p><strong>Examples of side effects:</strong></p>
              <ul>
                <li>Saving data to localStorage</li>
                <li>Updating the DOM directly (document.title, body class)</li>
                <li>Sending analytics events</li>
                <li>Logging to console for debugging</li>
                <li>Making API calls (though careful with this!)</li>
              </ul>

              <pre data-lang="typescript"><span class="kw">import</span> { Component, signal, effect } <span class="kw">from</span> <span class="str">'@angular/core'</span>;

      <span class="dec">@Component</span>({
        selector: <span class="str">'app-theme-toggle'</span>,
        template: <span class="str">""
          &lt;button (click)="toggleTheme()"&gt;
            Switch to {{ theme() === 'light' ? 'dark' : 'light' }} mode
          &lt;/button&gt;
        "</span>
      })
      <span class="kw">export class</span> ThemeComponent {
        theme = signal&lt;<span class="str">'light'</span> | <span class="str">'dark'</span>&gt;(<span class="str">'light'</span>);

        <span class="kw">constructor</span>() {
          <span class="cm">// This effect runs whenever theme() changes</span>
          effect(() => {
            const currentTheme = this.theme();

            <span class="cm">// 1. Update DOM (document body class)</span>
            document.body.className = currentTheme;

            <span class="cm">// 2. Save to localStorage (persists across page reloads)</span>
            localStorage.setItem(<span class="str">'theme'</span>, currentTheme);

            <span class="cm">// 3. Send analytics (track user preferences)</span>
            analytics.track(<span class="str">'theme_changed'</span>, { theme: currentTheme });

            <span class="cm">// 4. Console log for debugging</span>
            console.log(<span class="str">'Theme changed to:'</span>, currentTheme);
          });
        }

        toggleTheme() {
          this.theme.update(t => t === <span class="str">'light'</span> ? <span class="str">'dark'</span> : <span class="str">'light'</span>);
        }
      }</pre>
            </div>

            <div class="note red">
              <div class="note-label">🚨 CRITICAL: What NOT to do in effects</div>

              <p><strong>Never update a signal inside an effect that reads that same signal!</strong> This creates an infinite loop.</p>

              <pre data-lang="typescript"><span class="cm">// ❌ DANGER - Infinite loop!</span>
      <span class="kw">constructor</span>() {
        effect(() => {
          const value = this.count();  <span class="cm">// Reading count</span>
          this.count.set(value + <span class="num">1</span>);  <span class="cm">// Updating count - triggers effect again!</span>
          <span class="cm">// count changes → effect runs → count changes → effect runs → FOREVER!</span>
        });
      }

      <span class="cm">// ✅ CORRECT - Use computed() for derived values</span>
      doubled = computed(() => this.count() * <span class="num">2</span>);  <span class="cm">// No infinite loop!</span>

      <span class="cm">// ✅ CORRECT - Update DIFFERENT signals (not the one you read)</span>
      <span class="kw">constructor</span>() {
        effect(() => {
          const user = this.currentUser();  <span class="cm">// Reading user</span>
          this.lastAccessed.set(Date.now());  <span class="cm">// Updating DIFFERENT signal - safe!</span>
          this.userActivityLog.set([...this.userActivityLog(), user.id]);  <span class="cm">// Safe!</span>
        });
      }</pre>

              <div class="note amber">
                <div class="note-label">⚠️ Effect Rules Summary</div>
                <ul>
                  <li><strong>DO:</strong> Update DOM, localStorage, analytics, console.log, call external APIs</li>
                  <li><strong>DO NOT:</strong> Update the same signal you read</li>
                  <li><strong>DO NOT:</strong> Use effects to create derived state (use computed() instead)</li>
                  <li><strong>DO NOT:</strong> Rely on effects for component state management</li>
                </ul>
              </div>
            </div>
          </div>

