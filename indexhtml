      <span class="kw">import</span> { Injectable, signal } <span class="kw">from</span> <span class="str">'@angular/core'</span>;

      <span class="dec">@Injectable</span>({ providedIn: <span class="str">'root'</span> })
      <span class="kw">export class</span> CounterService {
        <span class="cm">// State stored in service (shared across components)</span>
        private count = signal(<span class="num">0</span>);

        <span class="cm">// Expose read-only version</span>
        readonly count$ = this.count.asReadonly();

        <span class="cm">// Methods to modify state</span>
        increment() {
          this.count.update(c => c + <span class="num">1</span>);
        }

        decrement() {
          this.count.update(c => c - <span class="num">1</span>);
        }

        reset() {
          this.count.set(<span class="num">0</span>);
        }
      }

