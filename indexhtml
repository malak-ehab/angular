            </div>

            <div class="note purple">
              <div class="note-label">📖 Complete Service with Explanations</div>

              <pre data-lang="typescript"><span class="cm">// user.service.ts</span>

      <span class="cm">// 1. Import required modules</span>
      <span class="kw">import</span> { Injectable } <span class="kw">from</span> <span class="str">'@angular/core'</span>;        <span class="cm">// Makes class injectable</span>
      <span class="kw">import</span> { HttpClient } <span class="kw">from</span> <span class="str">'@angular/common/http'</span>;   <span class="cm">// For HTTP requests</span>
      <span class="kw">import</span> { Observable, BehaviorSubject } <span class="kw">from</span> <span class="str">'rxjs'</span>;      <span class="cm">// For reactive streams</span>

      <span class="cm">// 2. Define the shape of a User object (TypeScript interface)</span>
      <span class="kw">export interface</span> <span class="tp">User</span> {
        id: <span class="tp">number</span>;        <span class="cm">// User ID (number)</span>
        name: <span class="tp">string</span>;      <span class="cm">// User's full name</span>
        email: <span class="tp">string</span>;     <span class="cm">// User's email address</span>
        <span class="cm">// Could have more fields: phone, address, role, etc.</span>
      }

      <span class="cm">// 3. @Injectable decorator - tells Angular "this is a service"</span>
      <span class="dec">@Injectable</span>({
        providedIn: <span class="str">'root'</span>    <span class="cm">// 'root' = ONE instance shared across entire app</span>
      })
      <span class="kw">export class</span> UserService {

        <span class="cm">// 4. Private property: API endpoint URL</span>
        <span class="kw">private</span> apiUrl = <span class="str">'/api/users'</span>;    <span class="cm">// Change this to your actual API URL</span>

        <span class="cm">// 5. BehaviorSubject - stores current value AND notifies subscribers</span>
        <span class="kw">private</span> usersSource = <span class="kw">new</span> BehaviorSubject&lt;<span class="tp">User</span>[]&gt;([]);
        <span class="cm">//   ↑ ↑ ↑                              ↑</span>
        <span class="cm">//   │ │ │                              └── Initial value: empty array</span>
        <span class="cm">//   │ │ └── This BehaviorSubject holds an ARRAY of User objects</span>
        <span class="cm">//   │ └── Creates a new BehaviorSubject</span>
        <span class="cm">//   └── Private = only UserService can update it</span>

        <span class="cm">// 6. Public Observable - components can LISTEN but not UPDATE</span>
        users$ = this.usersSource.asObservable();
        <span class="cm">//  ↑      ↑</span>
        <span class="cm">//  │      └── Converts BehaviorSubject to read-only Observable</span>
        <span class="cm">//  └── $ suffix = Angular convention for Observable</span>

        <span class="cm">// 7. Constructor - inject HttpClient dependency</span>
        <span class="kw">constructor</span>(
          <span class="kw">private</span> http: HttpClient    <span class="cm">// Angular automatically provides HttpClient</span>
        ) {}

        <span class="cm">// 8. Load all users from API</span>
        loadUsers(): <span class="tp">void</span> {    <span class="cm">// void = this method returns nothing</span>

          <span class="cm">// Make HTTP GET request to API</span>
          this.http.get&lt;<span class="tp">User</span>[]&gt;(this.apiUrl)    <span class="cm">// &lt;User[]&gt; = expect array of Users</span>
            .subscribe(users => {                   <span class="cm">// When data arrives...</span>

              <span class="cm">// Update the BehaviorSubject with new data</span>
              this.usersSource.next(users);         <span class="cm">// .next() = "emit this new value"</span>
              <span class="cm">// ALL components subscribed to users$ will AUTOMATICALLY update!</span>
            });
        }

        <span class="cm">// 9. Get single user by ID</span>
        getUserById(id: <span class="tp">number</span>): Observable&lt;<span class="tp">User</span>&gt; {    <span class="cm">// Returns Observable that emits ONE User</span>

          <span class="kw">return</span> this.http.get&lt;<span class="tp">User</span>&gt;(           <span class="cm">// Make HTTP GET request</span>
            <span class="str">\`\${this.apiUrl}/\${id}\`</span>          <span class="cm">// URL: /api/users/42</span>
          );
          <span class="cm">// Note: Does NOT store in BehaviorSubject (just returns data)</span>
        }
      }</pre>

              <div class="note amber">
                <div class="note-label">🎯 Understanding BehaviorSubject</div>
                <p><strong>Why use BehaviorSubject instead of a regular variable?</strong></p>

                <pre data-lang="typescript"><span class="cm">// ❌ Regular variable - components don't know when it changes</span>
      <span class="kw">private</span> users: User[] = [];
      getUsers() { <span class="kw">return</span> this.users; }
      <span class="cm">// Problem: If you update users, existing components won't know!</span>

      <span class="cm">// ✅ BehaviorSubject - components get notified of ALL changes</span>
      <span class="kw">private</span> usersSource = <span class="kw">new</span> BehaviorSubject&lt;User[]&gt;([]);
      users$ = this.usersSource.asObservable();
      <span class="cm">// When you call .next(newUsers), EVERY subscriber updates automatically!</span></pre>
