          <!-- ============================================= -->
          <!-- BLOCK 4: Using Services in Components         -->
          <!-- ============================================= -->
          <div class="block">
            <h3>Using the service inside a component</h3>

            <div class="note teal">
              <div class="note-label">📖 Component Injecting and Using Service</div>

              <pre data-lang="typescript"><span class="cm">// user-list.component.ts</span>

      <span class="kw">import</span> { Component, OnInit, OnDestroy } <span class="kw">from</span> <span class="str">'@angular/core'</span>;
      <span class="kw">import</span> { UserService, User } <span class="kw">from</span> <span class="str">'../services/user.service'</span>;
      <span class="kw">import</span> { Subject, takeUntil } <span class="kw">from</span> <span class="str">'rxjs'</span>;

      <span class="dec">@Component</span>({
        selector: <span class="str">'app-user-list'</span>,
        template: <span class="str">\`
          &lt;div *ngIf="loading"&gt;Loading users...&lt;/div&gt;
          &lt;ul&gt;
            &lt;li *ngFor="let user of users"&gt;
              {{ user.name }} - {{ user.email }}
            &lt;/li&gt;
          &lt;/ul&gt;
        \`</span>
      })
      <span class="kw">export class</span> UserListComponent <span class="kw">implements</span> OnInit, OnDestroy {

        users: User[] = [];           <span class="cm">// Store the user list for template</span>
        loading = <span class="kw">true</span>;             <span class="cm">// Show loading spinner</span>
        <span class="kw">private</span> destroy$ = <span class="kw">new</span> Subject&lt;<span class="tp">void</span>&gt;();  <span class="cm">// For cleanup</span>

        <span class="cm">// Option 1: Constructor injection (traditional)</span>
        <span class="kw">constructor</span>(
          <span class="kw">private</span> userService: UserService    <span class="cm">// Angular injects the service</span>
        ) {}

        <span class="cm">// Option 2: inject() function (modern, cleaner)</span>
        <span class="cm">// private userService = inject(UserService);</span>

        ngOnInit(): <span class="tp">void</span> {
          <span class="cm">// Subscribe to the shared user data stream</span>
          this.userService.users$
            .pipe(takeUntil(this.destroy$))      <span class="cm">// Auto-unsubscribe on destroy</span>
            .subscribe(users => {
              this.users = users;                <span class="cm">// Update local array</span>
              this.loading = <span class="kw">false</span>;              <span class="cm">// Hide loading spinner</span>
            });

          <span class="cm">// Trigger the data load (only once!)</span>
          this.userService.loadUsers();          <span class="cm">// Makes the HTTP request</span>
        }

        ngOnDestroy() {
          this.destroy$.next();                  <span class="cm">// Trigger unsubscribe</span>
          this.destroy$.complete();              <span class="cm">// Complete the subject</span>
        }
      }</pre>

              <div class="note amber">
                <div class="note-label">📖 Understanding the Flow</div>
                <ol>
                  <li><strong>Component starts</strong> → ngOnInit() runs</li>
                  <li><strong>Component subscribes</strong> → Listens to userService.users$</li>
                  <li><strong>Component calls loadUsers()</strong> → Service makes HTTP request</li>
                  <li><strong>Data arrives</strong> → Service calls usersSource.next(users)</li>
                  <li><strong>BehaviorSubject emits</strong> → All subscribers (components) get notified</li>
                  <li><strong>Component receives data</strong> → Updates this.users</li>
                  <li><strong>Template re-renders</strong> → Shows the user list</li>
                </ol>
                <p><strong>Key point:</strong> Multiple components can subscribe to the same users$. When data loads ONCE, ALL components update simultaneously!</p>
              </div>
            </div>
          </div>

          <!-- ============================================= -->
          <!-- BLOCK 5: BehaviorSubject Deep Dive            -->
          <!-- ============================================= -->
          <div class="block">
            <h3>BehaviorSubject explained</h3>

            <div class="note purple">
              <div class="note-label">📖 BehaviorSubject vs Regular Observable</div>

              <pre data-lang="typescript"><span class="kw">import</span> { BehaviorSubject, Observable, of } <span class="kw">from</span> <span class="str">'rxjs'</span>;

      <span class="cm">// REGULAR OBSERVABLE - Late subscribers miss previous values</span>
      <span class="kw">const</span> regular$ = of(<span class="num">1</span>, <span class="num">2</span>, <span class="num">3</span>);
      regular$.subscribe(v => console.log(<span class="str">'Subscriber A:'</span>, v));  <span class="cm">// Gets 1,2,3</span>
      <span class="cm">// Later...</span>
      regular$.subscribe(v => console.log(<span class="str">'Subscriber B:'</span>, v));  <span class="cm">// Gets NOTHING! (already completed)</span>

      <span class="cm">// BEHAVIORSUBJECT - Late subscribers get the LAST value immediately</span>
      <span class="kw">const</span> behavior$ = <span class="kw">new</span> BehaviorSubject(<span class="str">'Initial'</span>);  <span class="cm">// Must have initial value</span>
      behavior$.subscribe(v => console.log(<span class="str">'Subscriber A:'</span>, v));  <span class="cm">// Gets 'Initial'</span>

      behavior$.next(<span class="str">'New Value'</span>);  <span class="cm">// Both subscribers get 'New Value'</span>

      <span class="cm">// Later...</span>
      behavior$.subscribe(v => console.log(<span class="str">'Subscriber B:'</span>, v));  <span class="cm">// Gets 'New Value' immediately!</span></pre>

              <div class="note green">
                <div class="note-label">🎯 Why Use BehaviorSubject for State?</div>
                <ul>
                  <li><strong>Stores current value</strong> - You can always access .value</li>
                  <li><strong>Replays last value to new subscribers</strong> - No missed updates</li>
                  <li><strong>Perfect for shared state</strong> - Components always get current data</li>
                  <li><strong>Works with async pipe</strong> - Can use in templates directly</li>
                </ul>

                <pre data-lang="typescript"><span class="cm">// Service with BehaviorSubject</span>
      <span class="kw">private</span> userSubject = <span class="kw">new</span> BehaviorSubject&lt;User | <span class="kw">null</span>&gt;(<span class="kw">null</span>);
      currentUser$ = this.userSubject.asObservable();

      <span class="cm">// Get current value (synchronous, but use sparingly)</span>
      <span class="kw">const</span> current = this.userSubject.value;

      <span class="cm">// Update value (triggers all subscribers)</span>
      this.userSubject.next(newUser);

      <span class="cm">// In template - using async pipe</span>
      &lt;div *ngIf="userService.currentUser$ | async as user"&gt;
        Hello {{ user.name }}!
      &lt;/div&gt;</pre>
