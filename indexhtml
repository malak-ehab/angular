      <span class="kw">export class</span> ComponentB {
        counter = inject(CounterService);
        count = this.counter.count$;    <span class="cm">// Shows SAME count as ComponentA!</span>

        decrement() { this.counter.decrement(); }
      }

      <span class="cm">// When ComponentA increments → ComponentB sees the new value automatically!</span>
      <span class="cm">// That's the power of shared services with signals/BehaviorSubject!</span></pre>
