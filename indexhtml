      &lt;p&gt;{{ name | lowercase }}&lt;/p&gt;  <span class="cm">// Output: angular framework</span>
      &lt;p&gt;{{ name | titlecase }}&lt;/p&gt;   <span class="cm">// Output: Angular Framework</span>

