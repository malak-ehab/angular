      // ─── BUILD NAV ───
      const nav = document.getElementById("nav");
      const contentEl = document.getElementById("content");

      navGroups.forEach((group) => {
        const label = document.createElement("div");
        label.className = "nav-group-label";
        label.textContent = group.label;
        nav.appendChild(label);

        group.sections.forEach((id, i) => {
          const s = sections[id];
          if (!s) return;

          const btn = document.createElement("button");
          btn.className = "nav-btn";
          btn.dataset.id = id;
          btn.innerHTML = `<span class="nav-dot"></span>${s.label}`;
          btn.onclick = () => {
            document
              .querySelectorAll(".nav-btn")
              .forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            document
              .querySelectorAll(".section")
              .forEach((el) => el.classList.remove("visible"));
            document.getElementById("sec-" + id).classList.add("visible");
          };
          nav.appendChild(btn);
        });
      });

      // ─── BUILD CONTENT ───
      let isFirst = true;
      navGroups.forEach((group) => {
        group.sections.forEach((id) => {
          const s = sections[id];
          if (!s) return;

          const div = document.createElement("div");
          div.className = "section" + (isFirst ? " visible" : "");
          div.id = "sec-" + id;
          div.innerHTML = `
                                                            <div class="section-header">
                                                              <div class="section-tag">${s.tag}</div>
                                                              <h2>${s.title}</h2>
                                                              <p class="subtitle">${s.subtitle}</p>
                                                            </div>
                                                            ${s.content}
                                                          `;
          contentEl.appendChild(div);

          if (isFirst) {
            document
              .querySelector(`.nav-btn[data-id="${id}"]`)
              ?.classList.add("active");
            isFirst = false;
          }
        });
      });
