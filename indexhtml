          <div class="block">
            <h3>Complete Real-World Example: Search Component</h3>

            <div class="note green">
              <div class="note-label">📖 Putting It All Together</div>
              <pre data-lang="typescript"><span class="kw">import</span> { Component, OnInit, OnDestroy } <span class="kw">from</span> <span class="str">'@angular/core'</span>;
      <span class="kw">import</span> { FormControl } <span class="kw">from</span> <span class="str">'@angular/forms'</span>;
      <span class="kw">import</span> { Subject, Observable } <span class="kw">from</span> <span class="str">'rxjs'</span>;
      <span class="kw">import</span> { debounceTime, distinctUntilChanged, switchMap, takeUntil } <span class="kw">from</span> <span class="str">'rxjs/operators'</span>;

      <span class="dec">@Component</span>({
        selector: <span class="str">'app-search'</span>,
        template: <span class="str">
        "  &lt;input [formControl]="searchControl" placeholder="Search users..."&gt;

          &lt;div *ngIf="loading$ | async"&gt;Loading...&lt;/div&gt;

          &lt;ul&gt;
            &lt;li *ngFor="let user of results$ | async"&gt;
              {{ user.name }} - {{ user.email }}
            &lt;/li&gt;
          &lt;/ul&gt;"
        </span>
      })
      <span class="kw">export class</span> SearchComponent <span class="kw">implements</span> OnInit, OnDestroy {
        searchControl = <span class="kw">new</span> FormControl(<span class="str">''</span>);
        results$: Observable&lt;User[]&gt;;
        loading$ = <span class="kw">new</span> BehaviorSubject&lt;boolean&gt;(<span class="kw">false</span>);
        <span class="kw">private</span> destroy$ = <span class="kw">new</span> Subject&lt;<span class="tp">void</span>&gt;();

        <span class="kw">constructor</span>(<span class="kw">private</span> searchService: SearchService) {}

        ngOnInit() {
          <span class="cm">// Create the search stream with all operators</span>
          this.results$ = this.searchControl.valueChanges.pipe(
            debounceTime(<span class="num">300</span>),              <span class="cm">// Wait for user to stop typing</span>
            distinctUntilChanged(),         <span class="cm">// Don't search for same term twice</span>
            switchMap(term => {              <span class="cm">// Cancel previous searches</span>
              this.loading$.next(<span class="kw">true</span>);     <span class="cm">// Show loading spinner</span>
              <span class="kw">return</span> this.searchService.search(term);
            }),
            takeUntil(this.destroy$)         <span class="cm">// Auto cleanup</span>
          );

          <span class="cm">// Hide loading when results arrive</span>
          this.results$.subscribe(() => this.loading$.next(<span class="kw">false</span>));
        }

        ngOnDestroy() {
          this.destroy$.next();
          this.destroy$.complete();
        }
      }</pre>

