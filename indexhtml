              <pre data-lang="typescript"><span class="cm">// Require that T has a 'name' property</span>
      interface HasName {
        name: string;
      }

      function greet&lt;T extends HasName&gt;(obj: T): string {
        return "Hello, dollar sign{obj.name}!"";  <span class="cm">// TypeScript knows obj has a 'name' property</span>
