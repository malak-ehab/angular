              <pre data-lang="typescript"><span class="cm">// Component</span>
      <span class="kw">export class</span> UserComponent {
        user$ = this.userService.getUser();  <span class="cm">// Observable that emits a user</span>
        users$ = this.userService.getUsers();  <span class="cm">// Observable that emits array of users</span>
        time$ = interval(<span class="num">1000</span>);  <span class="cm">// Emits every second</span>
      }</pre>

              <pre data-lang="html"><span class="cm">&lt;!-- Async pipe automatically subscribes and unsubscribes --&gt;</span>
      &lt;div *ngIf="user$ | async as user"&gt;
        &lt;p&gt;Name: {{ user.name }}&lt;/p&gt;
        &lt;p&gt;Email: {{ user.email }}&lt;/p&gt;
      &lt;/div&gt;

      <span class="cm">&lt;!-- With ngFor --&gt;</span>
      &lt;ul&gt;
        &lt;li *ngFor="let user of users$ | async"&gt;
          {{ user.name }}
        &lt;/li&gt;
      &lt;/ul&gt;

      <span class="cm">&lt;!-- With @for --&gt;</span>
      @for (user of users$ | async; track user.id) {
        &lt;div&gt;{{ user.name }}&lt;/div&gt;
      }

      <span class="cm">&lt;!-- Without async pipe (BAD - memory leak risk!) --&gt;</span>
      <span class="cm">&lt;!-- Don't do this: --&gt;</span>
      <span class="cm">&lt;!-- user$ is an Observable, not the actual value! --&gt;</span>
      &lt;p&gt;{{ user$ }}&lt;/p&gt;  <span class="cm">// Shows "[object Object]" not the user data!</span></pre>

              <div class="note red">
                <div class="note-label">🚨 Why Async Pipe is Important</div>
                <ul>
                  <li><strong>Automatic subscription management</strong> - Subscribes when component renders, unsubscribes when destroyed</li>
                  <li><strong>No memory leaks</strong> - You don't need to manually unsubscribe in ngOnDestroy</li>
                  <li><strong>Cleaner code</strong> - No .subscribe() in component, no destroy$ subjects</li>
                  <li><strong>Works with Change Detection</strong> - Automatically triggers updates when new data arrives</li>
                </ul>

                <div class="note green">
                  <div class="note-label">✅ Recommended Pattern</div>
                  <pre data-lang="typescript"><span class="cm">// Component - NO subscription, just expose Observable</span>
      <span class="kw">export class</span> UserListComponent {
        users$ = this.userService.getUsers();  <span class="cm">// Observable, not data!</span>
      }

      <span class="cm">// Template - async pipe handles subscription</span>
      @for (user of users$ | async; track user.id) {
        &lt;div&gt;{{ user.name }}&lt;/div&gt;
      }</pre>
                </div>
              </div>
