            <h3>TocService — builds table of contents from DOM</h3>
            <p>Scans the rendered documentation HTML, finds all h2 and h3 headings, and builds a Table of Contents. The sidebar component subscribes to this service to display navigation links.</p>

            <div class="file-card">
              <div class="file-card-header">
                <span class="fname">toc.service.ts</span>
                <span class="fdesc">DOM-scraping TOC builder</span>
              </div>
              <pre data-lang="typescript"><span class="kw">export interface</span> <span class="tp">TocItem</span> {
        id: <span class="tp">string</span>;
        text: <span class="tp">string</span>;
        level: <span class="tp">number</span>;
