      numbers$.subscribe(v => console.log(<span class="str">'Subscriber 2:'</span>, v));  <span class="cm">// Gets NOTHING! Already completed!</span></pre>

              <p><strong>Solution - BehaviorSubject:</strong> Stores the LAST value and gives it to new subscribers immediately!</p>
              <pre data-lang="typescript"><span class="kw">import</span> { BehaviorSubject } <span class="kw">from</span> <span class="str">'rxjs'</span>;

      <span class="cm">// Create BehaviorSubject with initial value (required!)</span>
      <span class="kw">const</span> currentUser$ = <span class="kw">new</span> BehaviorSubject&lt;User | <span class="kw">null</span>&gt;(<span class="kw">null</span>);

      <span class="cm">// Subscriber 1 - gets initial null immediately</span>
      currentUser$.subscribe(user => console.log(<span class="str">'Sub 1:'</span>, user));  <span class="cm">// Prints: null</span>

      <span class="cm">// Update the value</span>
      currentUser$.next({ id: <span class="num">1</span>, name: <span class="str">'John'</span> });  <span class="cm">// Sub 1 gets: { id: 1, name: 'John' }</span>

      <span class="cm">// Subscriber 2 subscribes LATE - still gets the current value!</span>
      currentUser$.subscribe(user => console.log(<span class="str">'Sub 2:'</span>, user));  <span class="cm">// Prints: { id: 1, name: 'John' } IMMEDIATELY!</span></pre>

              <p><strong>Real Angular Service Example:</strong></p>
              <pre data-lang="typescript"><span class="dec">@Injectable</span>({ providedIn: <span class="str">'root'</span> })
