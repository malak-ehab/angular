          <!-- ============================================= -->
          <div class="block">
            <h3>computed() — derived, memoized values</h3>
            <p><code>computed()</code> is a read-only signal. It tracks its dependencies automatically and only recalculates when one of them changes. It never re-runs if dependencies haven't changed — this is memoization.</p>

            <div class="note teal">
              <div class="note-label">📖 What is a Computed Signal?</div>

              <p><strong>Analogy - Spreadsheet Formula:</strong> In Excel, if you have <code>=A1 + B1</code>, whenever A1 or B1 changes, the formula automatically recalculates. You don't have to manually update it. That's exactly what computed() does!</p>

              <pre data-lang="typescript"><span class="kw">import</span> { Component, signal, computed } <span class="kw">from</span> <span class="str">'@angular/core'</span>;

      <span class="dec">@Component</span>({
        selector: <span class="str">'app-shopping-cart'</span>,
        template: <span class="str">"
          &lt;p&gt;Price: {{ price() | currency }}&lt;/p&gt;
          &lt;p&gt;Quantity: {{ quantity() }}&lt;/p&gt;
          &lt;p&gt;Subtotal: {{ subtotal() | currency }}&lt;/p&gt;
          &lt;p&gt;Tax (8%): {{ tax() | currency }}&lt;/p&gt;
          &lt;p&gt;&lt;strong&gt;Total: {{ total() | currency }}&lt;/strong&gt;&lt;/p&gt;

          &lt;button (click)="increaseQuantity()"&gt;Add One&lt;/button&gt;
        "</span>
      })
      <span class="kw">export class</span> ShoppingCartComponent {
        <span class="cm">// Base signals (source of truth)</span>
        price = signal(<span class="num">100</span>);      <span class="cm">// $100 per item</span>
        quantity = signal(<span class="num">3</span>);     <span class="cm">// 3 items</span>
        taxRate = signal(<span class="num">0.08</span>);   <span class="cm">// 8% tax</span>

        <span class="cm">// Computed signals (derived from base signals)</span>
        subtotal = computed(() => {
          console.log(<span class="str">'Recalculating subtotal...'</span>);
          <span class="kw">return</span> this.price() * this.quantity();
        });  <span class="cm">// 100 * 3 = 300</span>

        tax = computed(() => {
          console.log(<span class="str">'Recalculating tax...'</span>);
          <span class="kw">return</span> this.subtotal() * this.taxRate();
        });  <span class="cm">// 300 * 0.08 = 24</span>

        total = computed(() => {
          console.log(<span class="str">'Recalculating total...'</span>);
          <span class="kw">return</span> this.subtotal() + this.tax();
        });  <span class="cm">// 300 + 24 = 324</span>

        increaseQuantity() {
          this.quantity.update(q => q + <span class="num">1</span>);  <span class="cm">// quantity becomes 4</span>
          <span class="cm">// Automatic cascade:</span>
          <span class="cm">// 1. subtotal recalculates: 100 * 4 = 400</span>
          <span class="cm">// 2. tax recalculates: 400 * 0.08 = 32</span>
          <span class="cm">// 3. total recalculates: 400 + 32 = 432</span>
          <span class="cm">// 4. Template updates automatically!</span>
        }
      }</pre>

