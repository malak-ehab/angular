          <!-- ============================================= -->
          <!-- BLOCK 4: Generics - Reusable Typed Code       -->
          <!-- ============================================= -->
          <div class="block">
            <h3>Generics — reusable typed code</h3>

            <div class="note blue">
              <div class="note-label">📖 What are Generics?</div>
              <p>Generics allow you to write code that works with ANY type, while STILL maintaining type safety. Think of them as "type variables" or "placeholders for types."</p>

              <p><strong>Analogy - Shipping Box:</strong> A shipping box (generic function) can hold anything - books, clothes, electronics. The box doesn't care WHAT is inside. But when you open it, you know what you put in!</p>
            </div>

            <div class="note purple">
              <div class="note-label">📖 Basic Generic Function</div>

              <pre data-lang="typescript"><span class="cm">// T is a placeholder for "whatever type you pass"</span>
      function identity&lt;T&gt;(value: T): T {
        return value;
      }

      <span class="cm">// When you call it with a number, T becomes number</span>
      let numResult: number = identity&lt;number&gt;(42);  <span class="cm">// Returns number</span>

      <span class="cm">// When you call it with a string, T becomes string</span>
      let strResult: string = identity&lt;string&gt;("hello");  <span class="cm">// Returns string</span>

      <span class="cm">// TypeScript can infer T automatically (no need to write &lt;number&gt;)</span>
      let inferredNum = identity(100);  <span class="cm">// TypeScript knows this is number</span>
      let inferredStr = identity("world");  <span class="cm">// TypeScript knows this is string</span></pre>
            </div>

            <div class="note teal">
              <div class="note-label">📖 Generic Function Example</div>

              <pre data-lang="typescript"><span class="cm">// A function that returns the first element of ANY array</span>
      function getFirst&lt;T&gt;(arr: T[]): T | undefined {
        return arr[0];
      }

      const numbers = [1, 2, 3];
      const firstNumber = getFirst(numbers);  <span class="cm">// TypeScript knows this is number | undefined</span>

      const names = ["Alice", "Bob", "Charlie"];
      const firstName = getFirst(names);  <span class="cm">// TypeScript knows this is string | undefined</span>

      const users = [user1, user2, user3];
      const firstUser = getFirst(users);  <span class="cm">// TypeScript knows this is User | undefined</span>

      <span class="cm">// Without generics, you'd need a separate function for each type!</span>
      <span class="cm">// Or you'd have to use 'any' which loses type safety</span></pre>
            </div>

