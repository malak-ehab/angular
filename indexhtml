          <!-- ============================================= -->
          <!-- BLOCK 3: How Angular Bootstraps              -->
          <!-- ============================================= -->
          <div class="block">
            <h3>How Angular bootstraps</h3>

            <div class="note purple">
              <div class="note-label">📖 The Bootstrap Process Explained</div>

              <pre data-lang="typescript"><span class="cm">// main.ts — the entry point (where everything starts)</span>

      <span class="cm">// 1. Import what we need</span>
      <span class="kw">import</span> { bootstrapApplication } <span class="kw">from</span> <span class="str">'@angular/platform-browser'</span>;
      <span class="kw">import</span> { AppComponent } <span class="kw">from</span> <span class="str">'./app/app.component'</span>;
      <span class="kw">import</span> { appConfig } <span class="kw">from</span> <span class="str">'./app/app.config'</span>;

      <span class="cm">// 2. Start the Angular application</span>
      <span class="cm">// This tells Angular: "Load AppComponent and put it in index.html where &lt;app-root&gt; is"</span>
      bootstrapApplication(AppComponent, appConfig)
        .catch(err => console.error(err));  <span class="cm">// If something fails, log the error</span>

      <span class="cm">// app.config.ts — register global providers (things every component can use)</span>
      <span class="kw">export const</span> appConfig = {
        providers: [
          provideRouter(routes),      <span class="cm">// Enable routing (so users can navigate)</span>
          provideHttpClient(),        <span class="cm">// Enable HTTP requests (to talk to APIs)</span>
          <span class="cm">// Add more global providers here</span>
        ]
      };</pre>

              <div class="note amber">
                <div class="note-label">🎯 Step-by-Step Bootstrap Sequence</div>

                <ol>
                  <li><strong>User opens website</strong> - Browser requests index.html from server</li>
                  <li><strong>index.html loads</strong> - Contains <code>&lt;app-root&gt;&lt;/app-root&gt;</code> placeholder</li>
                  <li><strong>Angular scripts load</strong> - main.js, polyfills.js, runtime.js are downloaded</li>
                  <li><strong>Angular starts</strong> - Executes main.ts, calls bootstrapApplication()</li>
                  <li><strong>Angular reads appConfig</strong> - Sets up routing, HTTP client, etc.</li>
                  <li><strong>Angular creates AppComponent</strong> - Builds the root component with its template</li>
                  <li><strong>Angular replaces &lt;app-root&gt;</strong> - Inserts the rendered AppComponent into the DOM</li>
                  <li><strong>App is ready!</strong> - User sees the application and can interact</li>
                  <li><strong>User navigates</strong> - Router handles all subsequent navigation without reloads!</li>
                </ol>
              </div>
            </div>

            <div class="note teal">
              <div class="note-label">📖 What Happens in index.html</div>

              <pre data-lang="html"><span class="cm">&lt;!-- Before Angular starts (empty placeholder) --&gt;</span>
      &lt;body&gt;
        &lt;app-root&gt;&lt;/app-root&gt;
      &lt;/body&gt;

      <span class="cm">&lt;!-- After Angular bootstraps (AppComponent rendered) --&gt;</span>
      &lt;body&gt;
        &lt;app-root&gt;
          &lt;div class="app-container"&gt;
            &lt;app-header&gt;&lt;/app-header&gt;
            &lt;main&gt;
              &lt;router-outlet&gt;&lt;/router-outlet&gt;  <span class="cm">&lt;!-- Current page content here --&gt;</span>
            &lt;/main&gt;
            &lt;app-footer&gt;&lt;/app-footer&gt;
          &lt;/div&gt;
        &lt;/app-root&gt;
      &lt;/body&gt;</pre>

              <p><strong>Important:</strong> The <code>&lt;app-root&gt;</code> tag stays in the DOM. Angular just replaces its content. The tag itself is like a "mounting point" for the app.</p>
            </div>
          </div>

